# Build output (tools/build.sh, maked2x.sh)
*.a
*.o
*.d
*.elf
*.dol
*.orig
*.map
*.exe
build/
dist/
/stripios
source/mload-module/d2xdbg_ident.h

# Host test binaries (tests/host): any test_* except its sources, plus sanitizer and coverage output
tests/host/*/test_*
!tests/host/*/test_*.c
!tests/host/*/test_*.h
*.gcda
*.gcno
*.log
tests/host/ums/test_ums

# Wii keys and console data: never commit them
/keys/*
!/keys/.gitkeep
*keys.bin
otp.bin
common-key
sd-key
*.pem

# Local settings and run output
.venv/
.dev/
.runs/
__pycache__/
*.pyc

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
tests/host/usbs/test_usbs
tests/host/usbs/*.o
tests/host/fat/test_fat
tests/host/fat/test_diskio
tests/host/sdio/test_sdio
tests/host/fat/*.o

# Packages and scratch copies staged for a Wii; console dumps: never commit them
/stage/
/dist/
*.zip
*.wad
*.tmd
*.tik
nand.bin
seeprom.bin
boot0.bin
*.img
.docker-cache/
